# Front-end + gateway: compila o Angular e serve o estático no mesmo nginx
# que roteia /api/<contexto>/ para as APIs (infra/gateway/nginx.conf).
# Contexto de build: raiz do repositório.

FROM node:24-alpine AS build
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY infra/gateway/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/controle-estoque-web/browser /usr/share/nginx/html
EXPOSE 8080
