{
  "ControleEstoque": {
    "Hosting": {
      "ServiceName": "ControleEstoque.Estoque.API"
    },
    "Estoque": {
      "ConnectionString": "Host=localhost;Port=5432;Database=controle_estoque;Username=postgres;Password=postgres",
      "MediaPath": "/media"
    }
  },
  "Logging": {
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ ",
        "UseUtcTimestamp": true
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
